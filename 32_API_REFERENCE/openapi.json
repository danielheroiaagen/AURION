  "info": {
    "title": "AURION API",
    "description": "Voice Agent SaaS Core API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateTenantSettingsDto": {
        "type": "object",
        "properties": {
          "settings": {
            "type": "object",
            "description": "Full replacement for the tenant settings document.",
            "additionalProperties": true
          }
        },
        "required": [
          "settings"
        ]
      },
      "InviteUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email of the user to invite (global identity key)."
          },
          "display_name": {
            "type": "string",
            "description": "Display name for a newly created identity."
          },
          "role": {
            "type": "string",
            "enum": [
              "tenant_admin",
              "supervisor",
              "human_agent",
              "developer_integrator",
              "auditor"
            ]
          }
        },
        "required": [
          "email",
          "display_name",
          "role"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "UpdateMembershipDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "tenant_admin",
              "supervisor",
              "human_agent",
              "developer_integrator",
              "auditor"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          }
        }
      },
      "CreateKnowledgeDocumentDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "source_uri": {
            "type": "string",
            "description": "Where the document content lives.",
            "maxLength": 2048
          },
          "content_sha256": {
            "type": "string",
            "description": "Lowercase hex SHA-256 of the document content."
          }
        },
        "required": [
          "title",
          "content_sha256"
        ]
      },
      "ChangeKnowledgeDocumentStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "review",
              "published",
              "archived"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "StartVoiceSessionDto": {
        "type": "object",
        "properties": {
          "external_session_id": {
            "type": "string",
            "description": "Stable id from the realtime provider. Retries with the same id return the existing session.",
            "maxLength": 200
          }
        }
      },
      "ChangeVoiceSessionStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "started",
              "active",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "summary": {
            "type": "string",
            "description": "Conversation summary; accepted only on closing transitions. Encrypted at rest.",
            "maxLength": 20000
          },
          "outcome": {
            "type": "string",
            "description": "Business outcome; closing transitions only.",
            "maxLength": 500
          },
          "transcript_uri": {
            "type": "string",
            "description": "Transcript location; closing transitions only.",
            "maxLength": 2048
          }
        },
        "required": [
          "status"
        ]
      },
      "RequestActionDto": {
        "type": "object",
        "properties": {
          "action_type": {
            "type": "string",
            "enum": [
              "calendar.update",
              "ticket.create"
            ]
          },
          "voice_session_id": {
            "type": "string",
            "description": "Voice session this action originates from."
          },
          "request_payload": {
            "type": "object",
            "description": "Tool request payload. Encrypted at rest.",
            "additionalProperties": true
          }
        },
        "required": [
          "action_type",
          "request_payload"
        ]
      }
    }
  }
}
