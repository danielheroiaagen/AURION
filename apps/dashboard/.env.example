# Dashboard build-time configuration (ADR-021). All optional: without OIDC
# settings the sign-in screen offers manual token paste only (dev/hs256).
# PUBLIC client — there is deliberately no client secret variable.

# IdP authorization endpoint (https only).
VITE_OIDC_AUTHORIZATION_URL=
# IdP token endpoint (https only).
VITE_OIDC_TOKEN_URL=
# SPA application client id registered at the IdP.
VITE_OIDC_CLIENT_ID=
# Optional. Default: "openid profile". Refresh tokens are deliberately not
# requested (no offline_access).
VITE_OIDC_SCOPE=
# Optional. Some IdPs (e.g. Auth0) need an audience to issue API tokens.
VITE_OIDC_AUDIENCE=
