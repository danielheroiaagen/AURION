# AURION API — environment configuration contract
#
# Copy to `.env` and fill real values. NEVER commit `.env` (it is gitignored).
# The API fails closed: it will not start without a valid JWT_SECRET.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Expose Swagger in production only when explicitly enabled.
SWAGGER_ENABLED=false

# ---------------------------------------------------------------------------
# Authentication (ADR-007, ADR-016)
# ---------------------------------------------------------------------------
# `hs256` (default): symmetric verification for development/tests.
# `jwks`: RS256 against an external IdP — production MUST use this mode.
AUTH_MODE=hs256
# Required in hs256 mode. HS256 signing secret, minimum 32 characters.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# hs256: optional pinning. jwks: REQUIRED — tokens from an external IdP must
# be pinned to exactly one issuer and one audience.
JWT_ISSUER=
JWT_AUDIENCE=
# Required in jwks mode. The IdP's JWKS endpoint (https only).
AUTH_JWKS_URL=
# Optional. JWKS key cache lifetime in seconds (default 600).
AUTH_JWKS_CACHE_SECONDS=600

# ---------------------------------------------------------------------------
# Edge security (ADR-010)
# ---------------------------------------------------------------------------
# Comma-separated CORS allowlist. Empty means no cross-origin access.
CORS_ORIGINS=
# Rate limiting: max requests per TTL window.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Database (ADR-008, ADR-012)
# ---------------------------------------------------------------------------
# Required. The API fails closed without it. The connecting role must NOT have
# BYPASSRLS: Row-Level Security is part of the tenant isolation contract.
DATABASE_URL=postgres://user:password@localhost:5432/aurion
# Optional. Connection pool upper bound (default 10).
DATABASE_POOL_MAX=10
# Optional. Set to `require` to enforce verified TLS to the database.
DATABASE_SSL=

# ---------------------------------------------------------------------------
# Column encryption at rest (ADR-011, ADR-012)
# ---------------------------------------------------------------------------
# Required. Comma-separated `keyId:base64(32 random bytes)` entries; the FIRST
# entry encrypts new values, the rest remain decrypt-only for rotation.
# Rotation/retirement procedure: 05_SECURITY/key-rotation-runbook.md (ADR-015).
# Generate material with: openssl rand -base64 32
DATA_ENCRYPTION_KEYS=k1:replace-with-base64-32-bytes

# ---------------------------------------------------------------------------
# Action dispatch (ADR-014)
# ---------------------------------------------------------------------------
# `noop` (default): no external call; results are stamped dispatch_mode=noop.
# `hermes`: real dispatch to the HERMES workforce — requires URL + secret
# below, and the API refuses to start without them. Production MUST be hermes.
ACTION_DISPATCH_MODE=noop
# Required in hermes mode. https:// endpoint (plain http only for localhost,
# or private container networks with the explicit flag below).
HERMES_DISPATCH_URL=
# Optional. Allow plain-http dispatch to private-network hosts (compose
# service DNS). NEVER enable over public networks (ADR-020).
HERMES_DISPATCH_ALLOW_INSECURE_HTTP=false
# Required in hermes mode. HMAC-SHA256 signing secret, minimum 32 characters.
HERMES_DISPATCH_SECRET=
# Optional. Dispatch timeout in milliseconds (default 10000).
HERMES_DISPATCH_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Voice gateway (ADR-018) — separate process `apps/voice-gateway`
# ---------------------------------------------------------------------------
# Required. Base URL of the AURION API the gateway records everything in.
AURION_API_URL=http://localhost:3000
# Required. JWT for a voice_agent machine actor (tool execution stays
# human-gated by policy; the gateway can only REQUEST actions).
VOICE_AGENT_TOKEN=
# Required. Comma-separated client connection keys (16+ chars each); the
# WebSocket handshake rejects connections without one. No unauthenticated mode.
VOICE_GATEWAY_CLIENT_KEYS=
# Optional. Brain adapter: `scripted` (deterministic dev/CI/demo, default)
# or `llm` (OpenAI-compatible Chat Completions endpoint, ADR-022).
BRAIN_MODE=scripted
# Required in llm mode. Base URL of an OpenAI-compatible API (e.g.
# https://api.openai.com/v1 or a local/hosted compatible endpoint).
LLM_API_URL=
# Required in llm mode.
LLM_API_KEY=
# Required in llm mode (e.g. gpt-4o-mini).
LLM_MODEL=
# Optional. Model call timeout in ms (default 30000) and reply budget.
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=300

# ---------------------------------------------------------------------------
# HERMES receiver (ADR-019) — separate process `apps/hermes-receiver`
# ---------------------------------------------------------------------------
# Required. Pairwise symmetric key; MUST equal the API's
# HERMES_DISPATCH_SECRET. Minimum 32 characters. There is no unsigned mode.
HERMES_RECEIVER_SECRET=
# Optional. Accepted clock drift for signed timestamps (default 300 seconds).
HERMES_STALENESS_WINDOW_SEC=300
# Optional. In-memory action_id dedupe capacity (default 10000).
HERMES_DEDUPE_CAPACITY=10000
