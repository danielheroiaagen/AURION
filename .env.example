# AURION API — environment configuration contract
#
# Copy to `.env` and fill real values. NEVER commit `.env` (it is gitignored).
# The API fails closed: it will not start without a valid JWT_SECRET.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Expose Swagger in production only when explicitly enabled.
SWAGGER_ENABLED=false

# ---------------------------------------------------------------------------
# Authentication (ADR-007)
# ---------------------------------------------------------------------------
# Required. HS256 signing secret, minimum 32 characters. Use a long random value.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Optional. When set, tokens must match these claims.
JWT_ISSUER=
JWT_AUDIENCE=

# ---------------------------------------------------------------------------
# Edge security (ADR-010)
# ---------------------------------------------------------------------------
# Comma-separated CORS allowlist. Empty means no cross-origin access.
CORS_ORIGINS=
# Rate limiting: max requests per TTL window.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Database (ADR-008) — used by the persistence layer when introduced
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/aurion
