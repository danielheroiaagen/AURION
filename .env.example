# AURION API — environment configuration contract
#
# Copy to `.env` and fill real values. NEVER commit `.env` (it is gitignored).
# The API fails closed: it will not start without a valid JWT_SECRET.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Expose Swagger in production only when explicitly enabled.
SWAGGER_ENABLED=false

# ---------------------------------------------------------------------------
# Authentication (ADR-007)
# ---------------------------------------------------------------------------
# Required. HS256 signing secret, minimum 32 characters. Use a long random value.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Optional. When set, tokens must match these claims.
JWT_ISSUER=
JWT_AUDIENCE=

# ---------------------------------------------------------------------------
# Edge security (ADR-010)
# ---------------------------------------------------------------------------
# Comma-separated CORS allowlist. Empty means no cross-origin access.
CORS_ORIGINS=
# Rate limiting: max requests per TTL window.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Database (ADR-008, ADR-012)
# ---------------------------------------------------------------------------
# Required. The API fails closed without it. The connecting role must NOT have
# BYPASSRLS: Row-Level Security is part of the tenant isolation contract.
DATABASE_URL=postgres://user:password@localhost:5432/aurion
# Optional. Connection pool upper bound (default 10).
DATABASE_POOL_MAX=10
# Optional. Set to `require` to enforce verified TLS to the database.
DATABASE_SSL=

# ---------------------------------------------------------------------------
# Column encryption at rest (ADR-011, ADR-012)
# ---------------------------------------------------------------------------
# Required. Comma-separated `keyId:base64(32 random bytes)` entries; the FIRST
# entry encrypts new values, the rest remain decrypt-only for rotation.
# Rotation/retirement procedure: 05_SECURITY/key-rotation-runbook.md (ADR-015).
# Generate material with: openssl rand -base64 32
DATA_ENCRYPTION_KEYS=k1:replace-with-base64-32-bytes

# ---------------------------------------------------------------------------
# Action dispatch (ADR-014)
# ---------------------------------------------------------------------------
# `noop` (default): no external call; results are stamped dispatch_mode=noop.
# `hermes`: real dispatch to the HERMES workforce — requires URL + secret
# below, and the API refuses to start without them. Production MUST be hermes.
ACTION_DISPATCH_MODE=noop
# Required in hermes mode. https:// endpoint (plain http only for localhost).
HERMES_DISPATCH_URL=
# Required in hermes mode. HMAC-SHA256 signing secret, minimum 32 characters.
HERMES_DISPATCH_SECRET=
# Optional. Dispatch timeout in milliseconds (default 10000).
HERMES_DISPATCH_TIMEOUT_MS=10000
