{
  "name": "aurion",
  "version": "0.1.0",
  "private": true,
  "description": "AURION Voice Agent SaaS Core monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:project && npm run test:tools",
    "test:project": "python -m unittest discover -s tests/project -p test_*.py",
    "test:tools": "python -m unittest tests.tools.test_create_github_repo",
    "test:api": "npm --workspace @aurion/api run test",
    "test:api:integration": "npm --workspace @aurion/api run test:integration",
    "test:dashboard": "npm --workspace @aurion/dashboard run test",
    "test:voice-gateway": "npm --workspace @aurion/voice-gateway run test",
    "test:hermes-receiver": "npm --workspace @aurion/hermes-receiver run test",
    "test:widget": "npm --workspace @aurion/widget run test",
    "e2e": "node tests/e2e/run-e2e.mjs",
    "openapi:generate": "npm --workspace @aurion/api run openapi:generate",
    "db:migrate": "node tools/db/migrate.mjs migrate",
    "db:status": "node tools/db/migrate.mjs status",
    "lint": "node tools/quality/lint.mjs",
    "typecheck": "npm --workspaces --if-present run typecheck"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  }
}
