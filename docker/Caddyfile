# Single-origin edge (ADR-020): / → dashboard, /api → API, /ws → gateway.
# On the VPS, replace :80 with the real domain and Caddy provisions TLS
# automatically (see 10_DEPLOYMENT/vps-deploy-runbook.md).
:80 {
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /ws* {
		reverse_proxy voice-gateway:8080
	}
	handle {
		reverse_proxy dashboard:80
	}
}
